+    static bool warned = false;
+    if (!warned) {
+      warned = true;
+      LOG_E(HW, "channel tap line exceeds the %zu-byte read buffer; taps are being truncated\n", bufSize);
+    }
+    int c;
+    while ((c = fgetc(f)) != EOF && c != '\n')
+      ;
+  }
+  return true;
+}
